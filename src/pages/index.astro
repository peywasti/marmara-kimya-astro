---
import Layout from "../layouts/Layout.astro";
import { products } from "../data/products.js";
import ProductCard from "../components/ProductCard.astro";
import CTA from "../components/CTA.astro";
---

<Layout title="Marmara Plastik Kimya - Anasayfa" hasHero={true}>
  <section
    class="hero"
    style="background-image: url('/images/hero/marmara-hero-4.avif');"
  >
    <div class="container">
      <h1>PLASTİK KİMYA</h1>
      <p class="hero-subtitle">SANAYİ VE TİCARET</p>
    </div>
  </section>

  <section class="section section-white">
    <div class="container">
      <div class="feature-grid">
        <div class="feature-block">
          <img
            src="/images/hero/marmara-hero-6.avif"
            alt="Tarımsal Çözümler"
            width="600"
            height="375"
            loading="lazy"
          />
          <h3>Tarımsal Çözümler</h3>
          <p>
            Modern ve sürdürülebilir tarımda, zararlılara ve hastalıklara karşı
            yenilikçi yöntemler uygulanarak birim alanda en yüksek verim ile
            gelir elde edilmesi amaçlanmaktadır.
          </p>
        </div>
        <div class="feature-block">
          <img
            src="/images/hero/marmara-hero-3.avif"
            alt="Gübre Programları"
            width="600"
            height="375"
            loading="lazy"
          />
          <h3>Gübre Programları</h3>
          <p>
            Gübreleme programları bitki yetiştirme için düzenli gübre uygulaması
            sağlar. Amaçları bitki büyümesini desteklemek, verimliliği artırmak
            ve besin eksikliklerini önlemektir.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="container">
      <h2 class="text-center">Ürünler</h2>
      <div class="product-grid">
        {products.map((product) => (
          <ProductCard
            slug={product.slug}
            name={product.name}
            image={product.image}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="container">
      <h2>Hakkımızda</h2>
      <p>
        Bu şirket 2013 yılında aşağıdaki türdeki ürünlerin üretimi, dağıtımı ve
        satışını yapmak amacıyla çalışmalarına başlamıştır.
      </p>
      <a href="/hakkimizda/" class="btn">
        Devamını oku
      </a>
    </div>
  </section>

  <CTA />
</Layout>
